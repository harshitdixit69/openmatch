# ── Supabase (OpenMatch backend — service role, server-side only) ───────
# Use the SAME project as the app so the agent can read `profiles` for
# lifecycle re-engagement and write its own marketing_* tables.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── LLM (content generation) ────────────────────────────────────────────
# Pick ONE provider:
#
# Option A — Cisco Enterprise AI (preferred; SAME creds as the edge functions,
# no OpenAI key needed). If CISCO_CLIENT_ID + CISCO_CLIENT_SECRET are set, the
# agent uses Cisco automatically and ignores OPENAI_API_KEY.
CISCO_CLIENT_ID=
CISCO_CLIENT_SECRET=
CISCO_APP_KEY=
# Optional overrides (defaults match the edge functions):
# CISCO_TOKEN_URL=https://id.cisco.com/oauth2/default/v1/token
# CISCO_AI_BASE_URL=https://chat-ai.cisco.com
# CISCO_AI_DEPLOYMENT=gemini-3.1-flash-lite
#
# Option B — OpenAI (only used when the Cisco vars above are blank).
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Publishing aggregator (Postiz self-host OR Ayrshare hosted) ─────────
# Leave blank to run publish in safe no-op mode (logs instead of posting).
MARKETING_AGGREGATOR_URL=
MARKETING_AGGREGATOR_KEY=

# ── App store links (injected into CTAs) ────────────────────────────────
APP_STORE_URL=https://apps.apple.com/app/openmatch/idXXXXXXXXX
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.harshi6565.openmatch
